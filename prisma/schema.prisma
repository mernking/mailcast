// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A Gmail sender account used to broadcast newsletters.
model SenderAccount {
  id            String   @id @default(cuid())
  /// Email address of the Gmail account, e.g. me@gmail.com
  email         String
  /// Display name shown to recipients in the From header
  fromName      String
  /// AES-256-GCM encrypted Gmail app password (hex:iv:ciphertext:tag)
  passwordEnc   String
  /// Whether this account has been verified to work
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns  Campaign[]
  workflows  Workflow[]
}

/// A subscriber / recipient that can receive broadcasts.
model Contact {
  id        String   @id @default(cuid())
  email     String
  name      String?
  tags      String   @default("") // comma separated
  source    String   @default("manual") // manual | import | form
  active    Boolean  @default(true)
  /// Telegram username (without @), if collected via a form
  telegram       String?
  /// Telegram numeric chat id, captured when the user messages the bot
  telegramChatId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients       CampaignRecipient[]
  enrollments      AutomationEnrollment[]
  groupAssignments ContactGroupAssignment[]

  @@index([email])
  @@index([active])
  @@index([telegram])
}

/// A newsletter broadcast campaign.
model Campaign {
  id          String   @id @default(cuid())
  title       String
  subject     String
  /// Markdown body (when contentType=markdown) or raw HTML (when contentType=html)
  content     String
  /// "markdown" | "html" — how `content` should be rendered
  contentType String   @default("markdown")
  /// Short preview text shown in inbox previews
  preheader   String?
  status      String   @default("draft") // draft | sending | sent | failed
  senderId    String
  sender      SenderAccount @relation(fields: [senderId], references: [id], onDelete: Restrict)
  /// Optional target group. If null, sends to all active contacts.
  targetGroupId String?
  targetGroup   ContactGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  totalRecip  Int      @default(0)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  openedCount Int      @default(0)
  clickedCount Int     @default(0)
  /// Per-campaign tracking switches
  trackOpens  Boolean  @default(false)
  trackClicks Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sentAt      DateTime?

  recipients CampaignRecipient[]

  @@index([status])
}

/// Per-recipient delivery record for a campaign.
model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  contactId  String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status     String   @default("pending") // pending | sent | failed
  error      String?
  sentAt     DateTime?

  @@unique([campaignId, contactId])
  @@index([campaignId])
}

/// A signup form that can be embedded on a website to collect subscribers.
model Form {
  id              String   @id @default(cuid())
  name            String
  /// JSON array of { name, label, type, required, placeholder }
  fields          String   @default("[]")
  buttonText      String   @default("Subscribe")
  successMessage  String   @default("Thanks for subscribing!")
  redirectUrl     String?
  /// Comma-separated tags added to contacts created by this form
  tagsToAdd       String   @default("")
  accentColor     String   @default("#1a1a1a")
  backgroundColor String   @default("#ffffff")
  textColor       String   @default("#1a1a1a")
  /// Back-relation to the group this form feeds (the group owns the link via formId).
  group           ContactGroup?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions FormSubmission[]
}

/// A single submission to a signup form.
model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  /// JSON of all submitted field values
  data      String   @default("{}")
  contactId String?
  createdAt DateTime @default(now())

  @@index([formId])
}

/// A collection/segment of contacts. Can be tied to a form (form submissions
/// auto-populate it) or managed manually.
model ContactGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#1a1a1a")
  /// If this group is tied to a form, the form's submissions populate it.
  /// Unique so a form feeds at most one group.
  formId      String?  @unique
  form        Form?    @relation(fields: [formId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments   ContactGroupAssignment[]
  campaigns     Campaign[]
}

/// Join table for Contact <-> ContactGroup (many-to-many).
model ContactGroupAssignment {
  id        String   @id @default(cuid())
  contactId String
  groupId   String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([contactId, groupId])
  @@index([groupId])
}

/// An automated workflow. The flow is stored as a graph ({nodes, edges}) in
/// `steps`. The trigger is a node inside the graph; `trigger`/`triggerConfig`
/// are denormalized mirrors for fast list display.
model Workflow {
  id             String   @id @default(cuid())
  name           String
  /// Denormalized trigger type (mirrors the trigger node) for list display.
  trigger        String   @default("manual")
  /// JSON trigger config mirroring the trigger node.
  triggerConfig  String   @default("{}")
  senderId       String
  sender         SenderAccount @relation(fields: [senderId], references: [id], onDelete: Restrict)
  /// JSON graph: { nodes: [...], edges: [...] } — React Flow format.
  steps          String   @default("{\"nodes\":[],\"edges\":[]}")
  enabled        Boolean  @default(true)
  enrolledCount  Int      @default(0)
  completedCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments AutomationEnrollment[]
}

/// A contact's progress through a workflow graph.
model AutomationEnrollment {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// Id of the next graph node to execute.
  currentNodeId String @default("")
  /// Legacy step index (unused for graph workflows; kept for backward compat).
  currentStep Int      @default(0)
  /// "active" | "completed" | "failed"
  status      String   @default("active")
  /// When the next node should run
  dueAt       DateTime @default(now())
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, dueAt])
  @@index([workflowId])
}

/// Key-value store for app settings (e.g. Telegram bot token, encrypted).
model Setting {
  key   String @id
  value String
}

/// Opaque token embedded in a sent email for an open or click event.
model TrackingToken {
  token       String   @id @unique
  campaignId  String
  recipientId String
  /// "open" | "click"
  kind        String
  /// Original destination for click tokens.
  url         String?
  createdAt   DateTime @default(now())

  @@index([campaignId, kind])
  @@index([recipientId, campaignId, kind])
}

/// A recorded open or click event for one campaign recipient.
/// One row per recipient/campaign open. Composite key makes dedupe atomic.
model TrackingOpen {
  campaignId  String
  recipientId String
  createdAt   DateTime @default(now())

  @@id([campaignId, recipientId])
}

model TrackingEvent {
  id          String   @id @default(cuid())
  tokenId     String
  campaignId  String
  recipientId String
  /// "open" | "click"
  kind        String
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([campaignId, kind])
  @@index([recipientId, campaignId, kind])
}

/// An image uploaded for use in campaign emails. Stored in the database so it
/// survives rebuilds of the standalone deployment.
model StoredFile {
  id        String   @id @default(cuid())
  name      String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}
